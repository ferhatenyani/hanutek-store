# ---------------------------------------------------------------------------
# hanutek — server environment. Copy to .env (never commit real values).
# Only NEXT_PUBLIC_* variables reach the browser; none are needed today.
# ---------------------------------------------------------------------------

NODE_ENV=development
# Public origin of the storefront (https in production). Used for e-mail links,
# the Google redirect URI and the CSRF origin check.
APP_URL=http://localhost:3000

# PostgreSQL in production, e.g. postgres://user:pass@host:5432/hanutek?sslmode=require
# Local dev/tests without Docker: embedded Postgres (PGlite) on disk.
DATABASE_URL=pglite:./.data/pglite
DATABASE_POOL_MAX=10

# >= 32 random bytes:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30

# Reverse proxies in front of the app (1 = one load balancer / nginx). 0 = ignore X-Forwarded-For.
TRUST_PROXY_HOPS=0
# Future admin app origins allowed to call /api/v1 with Bearer tokens (comma separated).
ADMIN_ORIGINS=

# Google sign-in (OAuth client "Web application"; redirect URI = APP_URL/api/v1/auth/google/callback).
# Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# E-mail: "console" logs messages (dev); "resend" sends via Resend.
MAIL_DRIVER=console
MAIL_FROM="hanutek <no-reply@hanutek.dz>"
RESEND_API_KEY=

# Product images: "local" writes to public/uploads (single server only); "s3" = S3-compatible (Cloudflare R2).
STORAGE_DRIVER=local
# Production with local storage: a persistent absolute path served by nginx at /uploads (default: ./public/uploads)
UPLOAD_DIR=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public CDN base for stored media, e.g. https://cdn.hanutek.dz (also whitelisted in CSP / next/image)
MEDIA_PUBLIC_URL=

LOG_LEVEL=info

# First admin account, created by `npm run db:seed` if it does not exist.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
